:: StoryScript [script]
/* LaineMapTest - Blueprint image
   Paste the entire contents of this file into Story > JavaScript.
*/
setup.mapImage = "data:image/webp;base64,";

setup.showMap = function () {
    var bar = document.getElementById("ui-bar-body");
    if (!bar) return;

    var oldMap = document.getElementById("laine-map-container");
    if (oldMap) oldMap.remove();

    var container = document.createElement("div");
    container.id = "laine-map-container";
    container.style.position = "relative";
    container.style.width = "100%";
    container.style.marginTop = "10px";

    var img = document.createElement("img");
    img.id = "laine-map";
    img.src = setup.mapImage;
    img.alt = "Map";
    img.style.width = "100%";
    img.style.height = "auto";
    img.style.display = "block";

    container.appendChild(img);
    bar.appendChild(container);
};

$(document).on(":passagedisplay", function () {
    setup.showMap();
});

/* MAP FOG-OF-WAR */

$(document).on(":passagedisplay", function () {

    var container = document.getElementById("laine-map-container");
    if (!container) return;

    /* Remove the previous fog */
    var oldFog = document.getElementById("map-fog");
    if (oldFog) oldFog.remove();

    var discovered = State.variables.discoveredRooms || [];

    /* Create the fog layer */
    var fog = document.createElementNS(
        "http://www.w3.org/2000/svg",
        "svg"
    );

    fog.id = "map-fog";

    fog.setAttribute("viewBox", "0 0 1152 1294");
    fog.setAttribute("preserveAspectRatio", "none");

    fog.style.position = "absolute";
    fog.style.left = "0";
    fog.style.top = "0";
    fog.style.width = "100%";
    fog.style.height = "100%";
    fog.style.pointerEvents = "none";

    /* Create the mask */
    var mask = document.createElementNS(
        "http://www.w3.org/2000/svg",
        "mask"
    );

    mask.id = "map-mask";

    /* Start with the entire map covered */
    var background = document.createElementNS(
        "http://www.w3.org/2000/svg",
        "rect"
    );

    background.setAttribute("x", "0");
    background.setAttribute("y", "0");
    background.setAttribute("width", "1152");
    background.setAttribute("height", "1294");
    background.setAttribute("fill", "white");

    mask.appendChild(background);

    /* Reveal Room 4 */
    if (discovered.includes("4")) {

        var room4 = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "circle"
        );

        room4.setAttribute("cx", "575");
        room4.setAttribute("cy", "876");
        room4.setAttribute("r", "142");
        room4.setAttribute("fill", "black");

        mask.appendChild(room4);
    }
  	/* Reveal Room 1 */
