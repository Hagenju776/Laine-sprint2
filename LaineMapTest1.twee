:: Caged Room(11) {"position":"1500,1200","size":"100,100"}
[[Right Wing(7)]] south(back)

<<set $hiddenRoomFound = true>>

<<if !$timerStarted>>
	<<set $timerStarted = true>>
    <<set $timeLeft = 180>>
    
     <<script>>
        State.variables.timerInterval = setInterval(function () {

            State.variables.timeLeft--;

            var timer = document.getElementById("timer-number");

            if (timer) {
                timer.textContent = State.variables.timeLeft;
            }

            if (State.variables.timeLeft <= 0) {
                clearInterval(State.variables.timerInterval);
                State.variables.timerInterval = null;

                Engine.play("Game Over");
            }

        }, 1000);
    <</script>>
<</if>>


